Output docs/demo.gif

Set Shell "bash"
Set Width 1200
Set Height 700
Set FontSize 18
Set TypingSpeed 100ms

Hide
Type "rm -rf /tmp/wassup-demo-contacts && cp -R docs/demo-contacts /tmp/wassup-demo-contacts && clear"
Enter
Type "./build/wassup-demo /tmp/wassup-demo-contacts"
Enter
Sleep 1s
Show

Sleep 3s
Tab
Sleep 2s

Type "/"
Type "sam"
Sleep 1s
Enter
Type "a"
Sleep 1.5s
Type "45"
Enter
Sleep 2s
Type "d"
Sleep 1.5s
Enter
Sleep 2s
Escape
Sleep 1s

Type "/"
Type "alex"
Sleep 1s
Enter
Type "s"
Sleep 1.5s
Type "7"
Enter
Sleep 2s
Escape
Sleep 1s

Type "/"
Type "maya"
Sleep 1s
Enter
Sleep 1s
Type "v"
Sleep 3s
Type "o"
Sleep 3s
Type ":q"
Enter
Sleep 2s
Escape
Sleep 3s
